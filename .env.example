DATABASE_URL=postgresql://costing:costing@localhost:5434/costing?schema=public
JWT_SECRET=change-me
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# First-run admin (used by `pnpm db:seed`; user must change password at first login)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
UPLOAD_DIR=./uploads
# Secret used to sign short-lived image URLs (defaults to JWT_SECRET when empty)
FILE_URL_SECRET=
# Set to true to disable the background cleanup of expired sessions and tokens
DISABLE_MAINTENANCE=false

# Production hardening (Phase 17)
# NODE_ENV=production
# JWT_SECRET must be random, 32+ characters (e.g. openssl rand -base64 48)
# WEB_ORIGIN=https://costing.example.com   (required in production; the only origin allowed by CORS)
# TRUST_PROXY=true                          (set when running behind nginx / a load balancer so client IPs are correct)
# ENABLE_SWAGGER=true                       (API docs are off in production unless set)
