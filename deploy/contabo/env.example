# /opt/smartcosting/.env  (root:sc-deploy, mode 640). install.sh creates it with fresh secrets; never commit the real file.
#
# Owner-only settings (sc-admin refuses to change these):
POSTGRES_PASSWORD=
JWT_SECRET=
FILE_URL_SECRET=
# loopback ports nginx proxies to; must not collide with PrayerTime (3000/4000/3010)
API_HOST_PORT=4100
WEB_HOST_PORT=3100
# memory/CPU limits on the shared 4 GB VM (about 1.3 GB in total)
DB_MEM_LIMIT=384m
API_MEM_LIMIT=512m
WEB_MEM_LIMIT=384m
DB_CPUS=1.0
API_CPUS=1.0
WEB_CPUS=1.0
# backups kept: nightly and pre-deploy sets (manual ones are kept until deleted)
BACKUP_KEEP_NIGHTLY=14
BACKUP_KEEP_PREDEPLOY=10
# previous image versions kept per service (for rollback)
DEPLOY_KEEP_IMAGES=3

# App settings the developer may change with `sc-admin set` (then `sc-admin restart api`):
WEB_ORIGIN=https://smartcosting.venoralab.com
ENABLE_SWAGGER=false
DISABLE_MAINTENANCE=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
