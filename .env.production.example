# Copy to .env.production and fill in. Never commit the real file.
DOMAIN=costing.example.com
ACME_EMAIL=admin@example.com
# openssl rand -hex 24   (letters and digits only: it goes inside the database URL)
POSTGRES_PASSWORD=
# openssl rand -base64 48   (32+ characters; the API refuses to start in production otherwise)
JWT_SECRET=
# optional, separate secret for signed image links (defaults to JWT_SECRET)
FILE_URL_SECRET=
ENABLE_SWAGGER=false
# Push notifications to browsers and phones (optional). Generate once, keep them: changing them signs every device out of push.
#   docker compose -f docker-compose.prod.yml --env-file .env.production run --rm api node -e "const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# a contact for the push services, e.g. mailto:admin@example.com
VAPID_SUBJECT=
